# SpendWise Environment Variables Configuration
# Copy this file to .env and fill in your actual values.

# Flask Application Secret Key (Used for session cryptography)
FLASK_SECRET_KEY=spendwise-super-secret-production-key-2026

# Google OAuth 2.0 Web Client ID
# Obtain from: https://console.cloud.google.com/apis/credentials
# Format: XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

